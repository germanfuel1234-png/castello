# ─────────────────────────────────────────────────────────────
# Castello · Gestión — Variables de entorno (ejemplo)
# Copiar a .env.local y completar.
# Sin base de datos configurada la app corre en MODO DEMO con datos
# ficticios claramente marcados (ver lib/data/mock.ts).
# ─────────────────────────────────────────────────────────────

# MySQL (proyecto propio — NO reusar el de otros clientes)
# Opción A: una sola URL de conexión
DATABASE_URL=
# Opción B: variables sueltas (si no usás DATABASE_URL)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# ── Reglas de negocio — NO inventar valores; dejar vacío hasta que el ──
# ── cliente (Mariano) los confirme (ej: comisión por venta, etc.)      ──
CASTELLO_COMISION_VENTA_PCT=

# ── Integraciones de publicación — BLOQUEADAS hasta tener credenciales ──
# ── reales (no completar con valores inventados). Scaffolding listo en ──
# ── lib/integrations/motordill.ts y lib/integrations/meta-catalogo.ts  ──

# Motordill empuja automáticamente a MercadoLibre (confirmado), por eso
# no hay variables separadas para ML.
MOTORDILL_API_KEY=
# Método de integración (API propia / feed XML / otro) sin confirmar todavía.
MOTORDILL_INTEGRATION_METHOD=

# Catálogo de Meta Commerce Manager — alimenta WhatsApp Catalog, Instagram
# Shopping y Facebook Shop a la vez (un solo catálogo, no uno por red).
META_ACCESS_TOKEN=
META_CATALOG_ID=
META_BUSINESS_ID=
